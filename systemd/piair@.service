[Unit]
Description=PiAir automatic playback for %i
Wants=network-online.target
After=network-online.target sound.target
# Three starts fit even an inclusive 60-second window at RestartSec=30s.
# Periodic recovery must never exhaust this limit after transient failures.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=%i
# Resolve the account's home through NSS, not /home/%i or manager %h.
WorkingDirectory=~
# Also reject UID 0 aliases. This runs with User= and the service sandbox.
ExecStartPre=/bin/sh -c 'test "$$(/usr/bin/id -u)" -ne 0'
ExecStart=/usr/local/bin/piair run --allow-unattended
StandardInput=null
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=30s
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30s
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=full
# Existing user-owned configuration and receiver-state must remain writable.
ProtectHome=no
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# AF_UNIX is required by the existing abstract per-user process lock.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Retain host networking and /dev/snd; no private network/device namespace.
PrivateNetwork=no
PrivateDevices=no

[Install]
WantedBy=multi-user.target
